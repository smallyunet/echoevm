{
  "manifest_version": 3,
  "name": "EchoEVM Browser Execution",
  "version": "1.4.0",
  "description": "Run verified pure contract functions and replay self-contained Ethereum transaction witnesses locally on Etherscan.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "EchoEVM Browser Execution"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://etherscan.io/tx/*",
        "https://www.etherscan.io/tx/*"
      ],
      "js": [
        "lib.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://etherscan.io/address/*",
        "https://www.etherscan.io/address/*"
      ],
      "js": [
        "lib.js",
        "contract.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
