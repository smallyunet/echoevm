    "release": "https://github.com/smallyunet/echoevm/releases/latest",
    "install": "brew install smallyunet/tap/echoevm",
    "boundary": "These snapshots execute locally in EchoEVM. The static page does not replay arbitrary Mainnet transactions or contact an RPC.",
    "local": "Run Solidity, bytecode, or standalone transaction witnesses through EchoEVM's independent execution kernel."
  },
