{
  "project": {
    "slug": "echoevm",
    "name": "EchoEVM",
    "title": "Explain EVM execution without the opcode flood.",
    "description": "EchoEVM executes Solidity and EVM bytecode, then selects bounded execution evidence for failures, calls, state, gas, ABI, and arithmetic.",
