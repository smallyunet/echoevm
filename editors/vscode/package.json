{
  "name": "echoevm",
  "displayName": "EchoEVM",
  "description": "Run Solidity functions in place with source-aware execution evidence and Geth comparison.",
  "version": "0.1.1",
  "publisher": "smallyu",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#f7f8fa",
    "theme": "light"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/smallyunet/echoevm.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Debuggers",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "solidity",
    "ethereum",
    "evm",
    "trace",
    "debugger"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "EchoEVM executes the workspace's Solidity compiler and contract bytecode."
    },
    "virtualWorkspaces": false
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:echoevm.runFunction",
    "onCommand:echoevm.runAndCompare",
    "onCommand:echoevm.showLastTrace",
    "onCommand:echoevm.setup",
    "onCommand:echoevm.openExample",
    "onView:echoevm.executionEvidence",
    "onLanguage:solidity"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "echoevm",
          "title": "EchoEVM",
          "icon": "images/echoevm-view.svg"
        }
      ]
    },
    "views": {
      "echoevm": [
        {
          "id": "echoevm.executionEvidence",
          "name": "Execution Evidence"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "echoevm.executionEvidence",
        "contents": "Run a Solidity function to inspect status, gas, state, source locations, and key execution steps.\n[Run Active Function](command:echoevm.runFunction)"
      }
    ],
    "commands": [
      {
        "command": "echoevm.runFunction",
        "title": "EchoEVM: Run Solidity Function",
        "icon": "$(play)"
      },
      {
        "command": "echoevm.runAndCompare",
        "title": "EchoEVM: Run and Compare with Geth",
        "icon": "$(compare-changes)"
      },
      {
        "command": "echoevm.showLastTrace",
        "title": "EchoEVM: Show Last Trace"
      },
      {
        "command": "echoevm.setup",
        "title": "EchoEVM: Setup and Diagnose Toolchain",
        "icon": "$(tools)"
      },
      {
        "command": "echoevm.openExample",
        "title": "EchoEVM: Open Getting Started Example",
        "icon": "$(beaker)"
      },
      {
        "command": "echoevm.runAtFunction",
        "title": "EchoEVM: Run This Function",
        "icon": "$(play)"
      },
      {
        "command": "echoevm.compareAtFunction",
        "title": "EchoEVM: Compare This Function with Geth",
        "icon": "$(compare-changes)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "echoevm.runFunction",
          "when": "resourceExtname == .sol",
          "group": "navigation@20"
        },
        {
          "command": "echoevm.runAndCompare",
          "when": "resourceExtname == .sol",
          "group": "navigation@21"
        }
      ],
      "editor/context": [
        {
          "command": "echoevm.runFunction",
          "when": "resourceExtname == .sol",
          "group": "navigation@20"
        },
        {
          "command": "echoevm.runAndCompare",
          "when": "resourceExtname == .sol",
          "group": "navigation@21"
        }
      ]
    },
    "configuration": {
      "title": "EchoEVM",
      "properties": {
        "echoevm.executablePath": {
          "type": "string",
          "default": "echoevm",
          "description": "Path to the EchoEVM executable. Setup installs from Homebrew on macOS; other supported platforms use a verified extension-managed CLI."
        },
        "echoevm.solcPath": {
          "type": "string",
          "default": "solc",
          "description": "Path to solc or solcjs. The default checks workspace node_modules, then uses bundled solc-js."
        },
        "echoevm.gasLimit": {
          "type": "number",
          "default": 1000000,
          "minimum": 1,
          "maximum": 30000000,
          "description": "Gas limit used for constructor deployment and function execution."
        },
        "echoevm.optimize": {
          "type": "boolean",
          "default": false,
          "description": "Enable the Solidity optimizer."
        },
        "echoevm.optimizerRuns": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Solidity optimizer runs. Zero uses the Foundry project value when available."
        },
        "echoevm.viaIR": {
          "type": "boolean",
          "default": false,
          "description": "Compile through the Solidity IR pipeline. Foundry via_ir is detected automatically."
        },
        "echoevm.remappings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional Solidity import remappings. foundry.toml and remappings.txt are detected automatically."
        },
        "echoevm.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional solc import paths, resolved relative to the nearest Foundry project or workspace folder."
        },
        "echoevm.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show Run and Compare actions above Solidity function declarations."
        },
        "echoevm.inlineResults": {
          "type": "boolean",
          "default": true,
          "description": "Show the latest execution result beside its Solidity source location and report execution failures in Problems."
        }
      }
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "compile-tests": "tsc --outDir out",
    "test": "npm run compile-tests && node --test out/test/*.test.js",
    "test:integration": "npm run bundle && node scripts/client-smoke.mjs",
    "bundle": "node esbuild.mjs",
    "vscode:prepublish": "npm run check && npm run test && npm run bundle",
    "package:vsix": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "solc": "0.8.30",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
