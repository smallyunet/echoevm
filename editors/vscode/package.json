{
  "name": "echoevm",
  "displayName": "EchoEVM",
  "description": "Compile, run, trace, and differentially compare Solidity functions with EchoEVM.",
  "version": "0.0.1",
  "publisher": "smallyu",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/smallyunet/echoevm.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Debuggers",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "solidity",
    "ethereum",
    "evm",
    "trace",
    "debugger"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "EchoEVM executes the workspace's Solidity compiler and contract bytecode."
    },
    "virtualWorkspaces": false
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:echoevm.runFunction",
    "onCommand:echoevm.runAndCompare",
    "onCommand:echoevm.showLastTrace",
    "onLanguage:solidity"
  ],
  "contributes": {
    "commands": [
      {
        "command": "echoevm.runFunction",
        "title": "EchoEVM: Run Solidity Function",
        "icon": "$(play)"
      },
      {
        "command": "echoevm.runAndCompare",
        "title": "EchoEVM: Run and Compare with Geth",
        "icon": "$(compare-changes)"
      },
      {
        "command": "echoevm.showLastTrace",
        "title": "EchoEVM: Show Last Trace"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "echoevm.runFunction",
          "when": "resourceExtname == .sol",
          "group": "navigation@20"
        },
        {
          "command": "echoevm.runAndCompare",
          "when": "resourceExtname == .sol",
          "group": "navigation@21"
        }
      ],
      "editor/context": [
        {
          "command": "echoevm.runFunction",
          "when": "resourceExtname == .sol",
          "group": "navigation@20"
        },
        {
          "command": "echoevm.runAndCompare",
          "when": "resourceExtname == .sol",
          "group": "navigation@21"
        }
      ]
    },
    "configuration": {
      "title": "EchoEVM",
      "properties": {
        "echoevm.executablePath": {
          "type": "string",
          "default": "echoevm",
          "description": "Path to the EchoEVM executable. In remote workspaces this path is resolved on the remote host."
        },
        "echoevm.solcPath": {
          "type": "string",
          "default": "solc",
          "description": "Path to the Solidity compiler executable."
        },
        "echoevm.gasLimit": {
          "type": "number",
          "default": 1000000,
          "minimum": 1,
          "maximum": 30000000,
          "description": "Gas limit used for constructor deployment and function execution."
        },
        "echoevm.optimize": {
          "type": "boolean",
          "default": false,
          "description": "Enable the Solidity optimizer."
        },
        "echoevm.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional solc import paths, resolved relative to the workspace folder."
        }
      }
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "compile-tests": "tsc --outDir out",
    "test": "npm run compile-tests && node --test out/test/*.test.js",
    "bundle": "node esbuild.mjs",
    "vscode:prepublish": "npm run check && npm run test && npm run bundle",
    "package:vsix": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}
